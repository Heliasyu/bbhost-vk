#!/bin/bash
# bbtest - bbhost-vk's test sessions on the player's PC (docs/vk/TESTING.md).
#
#   bbtest start <phase> [--record] [--capture] [--detach] [-- bbhost args...]
#                  launch ./bbhost from the game folder, log everything into a
#                  new session folder: the bbhost log, MangoHud frame times
#                  (CSV), a screenshot of the game's monitor every few seconds;
#                  --record keeps a 30 s gpu-screen-recorder replay buffer;
#                  --capture also lets bbhost dump the presented frame
#                  (BBHOST_VK_CAPTURE=1) at every mark; --detach returns at once.
#   bbtest mark [note...]   screenshot + last 30 s clip + a timestamped marker line
#   bbtest clip             save the last 30 s (with --record)
#   bbtest shot             one screenshot now
#   bbtest status           what is running, and where the session is
#   bbtest stop             stop the game and the helpers, bundle the session
#
# Sessions: ~/.local/share/bbtest/sessions/<YYYYmmdd-HHMMSS>-<phase>/
# It installs nothing and needs nothing beyond bash and coreutils; it uses
# what it finds: spectacle or gpu-screen-recorder (screenshots),
# gpu-screen-recorder (--record), MangoHud, kscreen-doctor + python3
# (finding the game's monitor), ImageMagick (cropping spectacle's shots).
#
# Settings (environment):
#   BBTEST_GAME_DIR    the folder with ./bbhost
#                      (default: "$HOME/BloodBorne PC/bbhost-linux-v0.2.18")
#   BBTEST_MONITOR     the game's monitor's output name, e.g. DP-1
#                      (default: the enabled output with the most pixels)
#   BBTEST_SHOT_EVERY  seconds between screenshots (default 10; 0 = none)
#   BBTEST_REPLAY_SECS replay buffer length (default 30)
#   BBTEST_FPS         recording frame rate (default 60)
#   BBTEST_MANGOHUD    1 (default) = MANGOHUD=1 with logging; keep = leave
#                      MANGOHUD alone (goverlay's setup); 0 = no MangoHud
#   BBTEST_ROOT        where sessions go (default ~/.local/share/bbtest)
set -u

ROOT=${BBTEST_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/bbtest}
GAME_DIR=${BBTEST_GAME_DIR:-$HOME/BloodBorne PC/bbhost-linux-v0.2.18}
STATE=${XDG_RUNTIME_DIR:-/tmp}/bbtest-$(id -u)
SHOT_EVERY=${BBTEST_SHOT_EVERY:-10}
REPLAY_SECS=${BBTEST_REPLAY_SECS:-30}
REC_FPS=${BBTEST_FPS:-60}

say() { printf 'bbtest: %s\n' "$*" >&2; }
now() { date '+%Y-%m-%d %H:%M:%S.%3N %Z'; }
have() { command -v "$1" > /dev/null 2>&1; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2> /dev/null; }
session() { [ -f "$STATE/session" ] && cat "$STATE/session"; }
pid_of() { [ -f "$STATE/$1.pid" ] && cat "$STATE/$1.pid"; }

notify() {
    have notify-send && notify-send -a bbtest -t 2500 "bbtest" "$*" > /dev/null 2>&1 &
}

# The game's monitor: BBTEST_MONITOR, else the enabled output with the most
# pixels (the 4K one on a 4K + 1440p desk). Prints "name x y w h scale" in
# logical coordinates when kscreen-doctor and python3 can say, else the name only.
monitor_info() {
    if have kscreen-doctor && have python3; then
        kscreen-doctor -j 2> /dev/null | BBTEST_MONITOR=${BBTEST_MONITOR:-} python3 -c '
import json, os, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
want = os.environ.get("BBTEST_MONITOR", "")
best = None
for o in d.get("outputs", []):
    if not o.get("enabled"):
        continue
    mode = next((m for m in o.get("modes", []) if str(m.get("id")) == str(o.get("currentModeId"))), None)
    if not mode:
        continue
    w, h = mode["size"]["width"], mode["size"]["height"]
    s = float(o.get("scale", 1) or 1)
    rot = o.get("rotation", 1)
    if rot in (2, 8):
        w, h = h, w
    rec = (o["name"], o["pos"]["x"], o["pos"]["y"], w, h, s)
    if want and o["name"] == want:
        best = rec
        break
    if not want and (best is None or w * h > best[3] * best[4]):
        best = rec
if best:
    print("%s %d %d %d %d %s" % best)
' && return 0
    fi
    [ -n "${BBTEST_MONITOR:-}" ] && echo "$BBTEST_MONITOR"
}

# A screenshot of the game's monitor into $1 (a .png path).
screenshot() {
    local out=$1 info name
    info=$(monitor_info)
    name=${info%% *}
    # gpu-screen-recorder takes one monitor's own pixels directly.
    # Tried once; when it fails (an older version, or no KMS permission) the
    # session uses spectacle from then on.
    if have gpu-screen-recorder && [ -n "$name" ] && [ ! -f "$STATE/gsr-shot-failed" ]; then
        if timeout 10 gpu-screen-recorder -w "$name" -o "$out" > /dev/null 2>&1 && [ -s "$out" ]; then
            return 0
        fi
        rm -f "$out"
        [ -d "$STATE" ] && : > "$STATE/gsr-shot-failed"
    fi
    if have spectacle; then
        local full=${out%.png}-full.png
        timeout 15 spectacle -b -n -f -o "$full" > /dev/null 2>&1
        [ -s "$full" ] || { rm -f "$full"; return 1; }
        local im=""
        have magick && im="magick"
        [ -z "$im" ] && have convert && im="convert"
        set -- $info
        if [ -n "$im" ] && [ $# -ge 6 ] && have python3; then
            # Spectacle's full shot covers every output; the crop is the game's
            # monitor scaled from logical coordinates to the image's pixels.
            local crop
            crop=$(python3 - "$full" "$2" "$3" "$4" "$5" "$6" <<'PY' 2> /dev/null
import json, struct, subprocess, sys
path, x, y, w, h, s = sys.argv[1], *map(float, sys.argv[2:])
with open(path, "rb") as f:
    head = f.read(24)
iw, ih = struct.unpack(">II", head[16:24])
d = json.loads(subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True).stdout)
right = bottom = 0.0
for o in d.get("outputs", []):
    if not o.get("enabled"):
        continue
    mode = next((m for m in o.get("modes", []) if str(m.get("id")) == str(o.get("currentModeId"))), None)
    if not mode:
        continue
    sc = float(o.get("scale", 1) or 1)
    right = max(right, o["pos"]["x"] + mode["size"]["width"] / sc)
    bottom = max(bottom, o["pos"]["y"] + mode["size"]["height"] / sc)
k = iw / right if right else 1.0
lw, lh = w / s, h / s
print("%dx%d+%d+%d" % (round(lw * k), round(lh * k), round(x * k), round(y * k)))
PY
)
            if [ -n "$crop" ] && $im "$full" -crop "$crop" +repage "$out" 2> /dev/null; then
                rm -f "$full"
                return 0
            fi
        fi
        mv -f "$full" "$out"
        return 0
    fi
    return 1
}

shot_loop() {
    local s=$1
    while [ -f "$STATE/session" ]; do
        sleep "$SHOT_EVERY"
        [ -f "$STATE/session" ] || break
        screenshot "$s/shots/auto-$(date +%H%M%S).png" || true
    done
}

redacted_toml() {  # the options file without its [account] section (the token)
    local f=$1
    [ -f "$f" ] || return 1
    awk '/^\[account\]/{skip=1; print "[account]  # removed by bbtest"; next} /^\[/{skip=0} !skip' "$f"
}

options_file() {
    local d=${BBHOST_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bbhost}
    echo "$d/bbhost-options.toml"
}

save_clip() {  # $1: a name for the log
    local gsr
    gsr=$(pid_of gsr)
    if ! alive "$gsr"; then
        say "no replay buffer (start with --record, and gpu-screen-recorder installed)"
        return 1
    fi
    local s n0 n1 i
    s=$(session)
    n0=$(find "$s/clips" -maxdepth 2 -type f -name '*.mp4' 2> /dev/null | wc -l)
    kill -USR1 "$gsr"
    for i in $(seq 1 40); do
        sleep 0.25
        n1=$(find "$s/clips" -maxdepth 2 -type f -name '*.mp4' 2> /dev/null | wc -l)
        [ "$n1" -gt "$n0" ] && break
    done
    local f
    f=$(find "$s/clips" -maxdepth 2 -type f -name '*.mp4' -printf '%T@ %p\n' 2> /dev/null | sort -n | tail -1 | cut -d' ' -f2-)
    echo "$(now) CLIP $1 ${f:-(still being written)}" >> "$s/marks.log"
    say "clip: ${f:-asked for; it lands in $s/clips}"
}

cmd_start() {
    local phase="" record=0 capture=0 detach=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --record) record=1 ;;
            --capture) capture=1 ;;
            --detach|-d) detach=1 ;;
            --) shift; break ;;
            -*) say "unknown option $1"; exit 2 ;;
            *) [ -z "$phase" ] && phase=$1 || { say "one phase name, e.g. p0"; exit 2; } ;;
        esac
        shift
    done
    [ -n "$phase" ] || { say "usage: bbtest start <phase> [--record] [--capture] [--detach]"; exit 2; }
    if [ -f "$STATE/session" ] && alive "$(pid_of game)"; then
        say "a session is running: $(session) (bbtest stop first)"
        exit 1
    fi
    [ -x "$GAME_DIR/bbhost" ] || { say "no ./bbhost in $GAME_DIR (set BBTEST_GAME_DIR)"; exit 1; }
    if [ "$detach" = 1 ]; then
        local args=(start "$phase")
        [ "$record" = 1 ] && args+=(--record)
        [ "$capture" = 1 ] && args+=(--capture)
        setsid -f "$0" "${args[@]}" -- "$@" > /dev/null 2>&1 < /dev/null
        sleep 1
        say "started in the background; bbtest status / bbtest stop"
        exit 0
    fi

    rm -rf "$STATE"
    mkdir -p "$STATE"
    local s
    s="$ROOT/sessions/$(date +%Y%m%d-%H%M%S)-$phase"
    mkdir -p "$s/shots" "$s/clips" "$s/mangohud" "$s/frames"
    echo "$s" > "$STATE/session"
    echo "$phase" > "$STATE/phase"
    date +%s > "$STATE/started"

    {
        echo "phase:    $phase"
        echo "started:  $(now)"
        echo "game dir: $GAME_DIR"
        echo "options:  record=$record capture=$capture shots-every=${SHOT_EVERY}s"
        echo "monitor:  $(monitor_info || echo '?')"
        [ -f "$GAME_DIR/bbhost.bin" ] && echo "bbhost.bin sha256: $(sha256sum "$GAME_DIR/bbhost.bin" | cut -d' ' -f1)"
        [ -f "$GAME_DIR/BUILDINFO.txt" ] && sed 's/^/build: /' "$GAME_DIR/BUILDINFO.txt"
        echo "kernel:   $(uname -r)"
        have vulkaninfo && vulkaninfo --summary 2> /dev/null | grep -E 'deviceName|driverInfo|apiVersion' | head -6 | sed 's/^ */vulkan:   /'
        have mangohud && echo "mangohud: present"
        have gpu-screen-recorder && echo "gpu-screen-recorder: present"
        have spectacle && echo "spectacle: present"
    } > "$s/session.txt"
    redacted_toml "$(options_file)" > "$s/options-before.toml" 2> /dev/null || rm -f "$s/options-before.toml"

    # MangoHud: frame times to CSV in the session. read_cfg keeps the
    # player's own MangoHud.conf (goverlay's layout) and adds the logging.
    local mh=${BBTEST_MANGOHUD:-1}
    if [ "$mh" = 1 ]; then
        export MANGOHUD=1
        export MANGOHUD_CONFIG="read_cfg,output_folder=$s/mangohud,autostart_log=1,log_interval=0,log_duration=0${MANGOHUD_CONFIG:+,$MANGOHUD_CONFIG}"
    elif [ "$mh" = 0 ]; then
        unset MANGOHUD
    fi
    if [ "$capture" = 1 ]; then
        export BBHOST_VK_CAPTURE=1
        export BBHOST_VK_CAPTURE_DIR="$s/frames"
    fi

    # The replay buffer of the game's monitor.
    if [ "$record" = 1 ]; then
        if have gpu-screen-recorder; then
            local name
            name=$(monitor_info)
            name=${name%% *}
            gpu-screen-recorder -w "${name:-screen}" -f "$REC_FPS" -r "$REPLAY_SECS" -c mp4 -o "$s/clips" \
                > "$s/gsr.log" 2>&1 &
            echo $! > "$STATE/gsr.pid"
            say "recording: the last ${REPLAY_SECS}s of ${name:-screen} (bbtest clip saves them)"
        else
            say "--record: gpu-screen-recorder is not installed; no clips this session"
        fi
    fi

    echo "$(now) START $phase" >> "$s/marks.log"
    say "session: $s"
    # The game, with its output appended to the log (bbtest mark appends too).
    (cd "$GAME_DIR" && exec ./bbhost "$@") > >(exec tee -a "$s/bbhost.log") 2>&1 &
    local game=$!
    echo "$game" > "$STATE/game.pid"
    echo "$$" > "$STATE/start.pid"
    if [ "$SHOT_EVERY" != 0 ]; then
        shot_loop "$s" &
        echo $! > "$STATE/shots.pid"
    fi
    trap 'kill -TERM "$game" 2> /dev/null' INT TERM
    wait "$game"
    local rc=$?
    # wait returns early on a trapped signal: wait for the game itself.
    while alive "$game"; do sleep 0.5; done
    trap - INT TERM
    echo "$(now) GAME-EXIT $rc" >> "$s/marks.log"
    finish "$s"
}

# Stops the helpers and bundles the session.
finish() {
    local s=$1
    [ -n "$s" ] && [ -d "$s" ] || return 0
    local p
    for p in shots gsr; do
        local pid
        pid=$(pid_of "$p")
        if alive "$pid"; then
            # TERM for the screenshot loop (a background job ignores INT);
            # INT for gpu-screen-recorder, its own way to stop.
            if [ "$p" = gsr ]; then kill -INT "$pid" 2> /dev/null; else kill -TERM "$pid" 2> /dev/null; fi
            for _ in $(seq 1 20); do alive "$pid" || break; sleep 0.25; done
            alive "$pid" && kill -KILL "$pid" 2> /dev/null
        fi
    done
    redacted_toml "$(options_file)" > "$s/options-after.toml" 2> /dev/null || rm -f "$s/options-after.toml"
    if [ -f "$s/options-before.toml" ] && [ -f "$s/options-after.toml" ]; then
        diff -u "$s/options-before.toml" "$s/options-after.toml" > "$s/options.diff" || true
    fi
    # bbhost's own log files written during the session (logs/ beside it).
    local started
    started=$(cat "$STATE/started" 2> /dev/null || echo 0)
    if [ -d "$GAME_DIR/logs" ]; then
        mkdir -p "$s/game-logs"
        find "$GAME_DIR/logs" -maxdepth 1 -type f -newermt "@$started" -exec cp -p {} "$s/game-logs/" \; 2> /dev/null
        rmdir "$s/game-logs" 2> /dev/null || true
    fi
    rm -f "$s/frames/capture.request"
    rmdir "$s/clips" "$s/frames" "$s/mangohud" 2> /dev/null || true
    {
        echo "stopped:  $(now)"
        # test6: the words alone matched 65 benign lines in test5 (the
        # occlusion report's "0 lost", "keyboard focus lost", the DL_PANIC
        # patch, MangoHud's own power/battery notes); those are left out.
        echo "errors in the log: $(grep -iE 'error|fatal|crash|panic|lost' "$s/bbhost.log" 2> /dev/null |
            grep -vcE '; 0 lost\)|keyboard focus lost|patched DL_PANIC|error paths would have dropped|\[MANGOHUD\] \[error\] \[(cpu|battery)\.cpp' || true)"
        # The FPS shown, in game only: the presenter's 300-frame lines after
        # the first in-game frame (loading screens and menus left out).
        echo "in-game fps shown: $(awk '/world: the first in-game frame/ { on = 1; next }
            on && /present: 300 frames in [0-9]+ ms/ { for (i = 1; i <= NF; i++) if ($i == "in") { ms += $(i + 1); n++; break } }
            END { if (n) printf "%.1f over %.0f s (%d windows of 300)", 300 * n / (ms / 1000), ms / 1000, n; else printf "none" }' "$s/bbhost.log" 2> /dev/null)"
        # test7: the frame pacing from MangoHud, in game only.
        local skip csv
        skip=$(sed -n 's/.*world: the first in-game frame, flip [0-9]*, \([0-9.]*\) s after start.*/\1/p' "$s/bbhost.log" 2> /dev/null | head -1)
        csv=$(find "$s/mangohud" -type f -name '*.csv' 2> /dev/null | head -1)
        local fs
        fs=$(frame_stats "$csv" "${skip:-0}")
        echo "in-game frames (MangoHud): $fs"
        # test8: the one number for a locked 120, on its own line.
        echo "120 LOCK: $(printf '%s' "$fs" | grep -oE '[0-9]+ of [0-9]+ seconds under 120' || echo 'no MangoHud CSV')"
        # test8: BBHOST_AB_SECONDS halves (bbhost's `ab:` lines), averaged per side.
        echo "a/b (BBHOST_AB_SECONDS): $(awk '/ab: motion blur skip (on|off) for/ {
                side = ($0 ~ /skip on/) ? "on" : "off"
                for (i = 1; i <= NF; i++) { if ($i == "fps,") fps[side] += $(i - 1); if ($i == "max") mx[side] = ($(i + 1) + 0 > mx[side]) ? $(i + 1) + 0 : mx[side]; if ($i == "over" && $(i + 1) == "12") o12[side] += $(i - 1) }
                n[side]++ }
            END { if (!n["on"] && !n["off"]) { printf "none"; exit }
                  for (k in n) printf "skip %s: %.1f fps over %d halves, max %.1f ms, %d over 12 ms; ", k, fps[k] / n[k], n[k], mx[k], o12[k] }' "$s/bbhost.log" 2> /dev/null)"
        echo "marks:    $(grep -c ' MARK ' "$s/marks.log" 2> /dev/null || true)"
        echo "shots:    $(find "$s/shots" -type f 2> /dev/null | wc -l)"
        echo "clips:    $(find "$s/clips" -type f -name '*.mp4' 2> /dev/null | wc -l)"
        echo "frames:   $(find "$s/frames" -type f -name '*.png' 2> /dev/null | wc -l)"
        echo "mangohud: $(find "$s/mangohud" -type f -name '*.csv' 2> /dev/null | wc -l) CSV"
    } >> "$s/session.txt"
    echo "$(now) STOP" >> "$s/marks.log"
    rm -rf "$STATE"
    say "session bundled: $s"
    notify "session saved: $(basename "$s")"
}

# test7: frame-time statistics from MangoHud's per-frame CSV (log_interval=0),
# the frames after `skip` seconds (bbhost's first in-game frame): average fps;
# 1% and 0.1% lows (1000 over the 99th and 99.9th percentile frame times); the
# frame times' standard deviation; the frames slower than 120 fps (8.42 ms:
# 1000/120 and 1% for jitter) and slower than 12 ms (a visible hitch); and
# the whole seconds that showed fewer than 119.5 frames - what an FPS counter
# under 120 is.
frame_stats() {
    local csv=$1 skip=${2:-0}
    [ -f "$csv" ] || { printf "no MangoHud CSV"; return 0; }
    local tmp
    tmp=$(mktemp)
    awk -F, -v skip="$skip" '
        $1 == "fps" { for (i = 1; i <= NF; i++) { if ($i == "frametime") ft = i; if ($i == "elapsed") el = i }; next }
        ft && el && $el / 1e9 >= skip && $ft > 0 { printf "%.6f %s\n", $el / 1e9, $ft }' "$csv" > "$tmp"
    local secs
    # Consecutive 1000 ms of frame time, as a counter would count them.
    secs=$(awk '{ t += $2; f++; if (t >= 1000) { w++; if (f < 119.5) low++; t -= 1000; f = 0 } }
        END { printf "%d of %d seconds under 120", low, w }' "$tmp")
    awk '{ print $2 }' "$tmp" | sort -g | awk -v secs="$secs" '
        { v[NR] = $1; s += $1; q += $1 * $1; if ($1 > 8.42) slow++; if ($1 > 12) hitch++ }
        END {
            n = NR
            if (n < 10) { printf "too few frames (%d)", n; exit }
            mean = s / n; sd = sqrt(q / n - mean * mean)
            p99 = v[int(n * 0.99)]; p999 = v[int(n * 0.999)]
            printf "%d frames, avg %.1f fps, 1%% low %.1f, 0.1%% low %.1f, frame time %.2f ms +- %.2f (max %.1f); over 8.42 ms %d (%.1f%%), over 12 ms %d; %s",
                n, 1000 / mean, 1000 / p99, 1000 / p999, mean, sd, v[n], slow, 100 * slow / n, hitch, secs
        }'
    rm -f "$tmp"
}

cmd_mark() {
    local s
    s=$(session)
    [ -n "$s" ] || { say "no session (bbtest start first)"; exit 1; }
    local t note=${*:-}
    t=$(date +%H%M%S-%3N)
    echo "$(now) MARK $t ${note}" >> "$s/marks.log"
    echo "[bbtest] ===== MARK $t $(now) ${note} =====" >> "$s/bbhost.log"
    # bbhost's own copy of the presented frame (bbtest start --capture).
    [ -d "$s/frames" ] && [ -n "$(pid_of game)" ] && grep -q "capture=1" "$s/session.txt" && : > "$s/frames/capture.request"
    screenshot "$s/shots/mark-$t.png" && echo "$(now) SHOT mark-$t.png" >> "$s/marks.log"
    alive "$(pid_of gsr)" && save_clip "mark-$t" > /dev/null 2>&1
    say "mark $t"
    notify "mark $t"
}

cmd_clip() {
    [ -n "$(session)" ] || { say "no session"; exit 1; }
    save_clip "clip"
}

cmd_shot() {
    local s
    s=$(session)
    [ -n "$s" ] || { say "no session"; exit 1; }
    local f
    f="$s/shots/shot-$(date +%H%M%S).png"
    screenshot "$f" && say "$f" || say "no screenshot tool worked (spectacle or gpu-screen-recorder)"
}

cmd_status() {
    local s
    s=$(session)
    if [ -z "$s" ]; then
        echo "no session"
        return 0
    fi
    echo "session: $s"
    for p in game shots gsr; do
        local pid
        pid=$(pid_of "$p")
        [ -n "$pid" ] && echo "$p: $pid $(alive "$pid" && echo running || echo gone)"
    done
    tail -3 "$s/marks.log" 2> /dev/null
}

cmd_stop() {
    local s
    s=$(session)
    [ -n "$s" ] || { say "no session"; exit 0; }
    local game start
    game=$(pid_of game)
    start=$(pid_of start)
    echo "$(now) STOP-ASKED" >> "$s/marks.log"
    if alive "$game"; then
        kill -TERM "$game" 2> /dev/null
        for _ in $(seq 1 40); do alive "$game" || break; sleep 0.25; done
        alive "$game" && { say "bbhost did not quit in 10 s; killing it"; kill -KILL "$game" 2> /dev/null; }
    fi
    # The start command bundles once the game is gone; wait for it.
    if alive "$start"; then
        for _ in $(seq 1 60); do [ -f "$STATE/session" ] || break; sleep 0.25; done
    fi
    [ -f "$STATE/session" ] && finish "$s"
    return 0
}

case "${1:-}" in
    start) shift; cmd_start "$@" ;;
    mark) shift; cmd_mark "$@" ;;
    clip) cmd_clip ;;
    shot) cmd_shot ;;
    status) cmd_status ;;
    stop) cmd_stop ;;
    *) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
